// Prisma schema for Quest-Based Learning Path Engine

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Quest Line: A themed collection of related quests
model QuestLine {
  id                  String    @id @default(cuid())
  communityId         String
  key                 String    @unique
  title               String
  descriptionMarkdown String    @db.Text
  themeTagsJson       Json      // { tags: string[], categories?: string[] }
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  quests              Quest[]

  @@index([communityId])
  @@map("quest_lines")
}

// Quest: An individual learning journey with multiple steps
model Quest {
  id               String    @id @default(cuid())
  questLineId      String
  key              String    @unique
  title            String
  summaryMarkdown  String    @db.Text
  difficulty       Int       // 1-5
  estimatedMinutes Int
  requiredTagsJson Json      // { required?: string[], preferred?: string[] }
  rewardJson       Json      // { currencyCode: string, amount: number, bonusMultiplier?: number }
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  questLine        QuestLine @relation(fields: [questLineId], references: [id], onDelete: Cascade)
  steps            QuestStep[]
  enrollments      MemberQuestEnrollment[]
  analytics        QuestAnalytics?
  prerequisites    QuestPrerequisite[] @relation("PrerequisiteQuest")
  dependentQuests  QuestPrerequisite[] @relation("DependentQuest")
  achievements     Achievement[]

  @@index([questLineId])
  @@map("quests")
}

// Quest Step: Individual actionable step within a quest
model QuestStep {
  id              String    @id @default(cuid())
  questId         String
  orderIndex      Int
  stepType        String    // 'read' | 'video' | 'exercise' | 'reflection' | 'ritual'
  title           String
  contentMarkdown String    @db.Text
  metaJson        Json      // { videoUrl?, readingUrl?, estimatedMinutes?, resources?: [] }
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  quest           Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  progress        MemberQuestStepProgress[]

  @@unique([questId, orderIndex])
  @@index([questId])
  @@map("quest_steps")
}

// Member Quest Enrollment: Tracks member participation in quests
model MemberQuestEnrollment {
  id          String    @id @default(cuid())
  memberId    String
  questId     String
  status      String    // 'not_started' | 'in_progress' | 'completed' | 'abandoned'
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  quest       Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  stepProgress MemberQuestStepProgress[]

  @@unique([memberId, questId])
  @@index([memberId])
  @@index([questId])
  @@index([status])
  @@map("member_quest_enrollments")
}

// Member Quest Step Progress: Tracks progress on individual steps
model MemberQuestStepProgress {
  id                   String   @id @default(cuid())
  memberEnrollmentId   String
  stepId               String
  status               String   // 'locked' | 'available' | 'completed'
  updatedAt            DateTime @updatedAt
  evidenceJson         Json?    // { completedAt?, notes?, timeSpentMinutes?, submittedContent? }
  createdAt            DateTime @default(now())

  enrollment           MemberQuestEnrollment @relation(fields: [memberEnrollmentId], references: [id], onDelete: Cascade)
  step                 QuestStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([memberEnrollmentId, stepId])
  @@index([memberEnrollmentId])
  @@index([stepId])
  @@map("member_quest_step_progress")
}

// Quest Prerequisites: Defines quest dependencies
model QuestPrerequisite {
  id                String   @id @default(cuid())
  questId           String   // The quest that has prerequisites
  prerequisiteId    String   // The quest that must be completed first
  required          Boolean  @default(true) // If false, it's just a recommendation
  createdAt         DateTime @default(now())

  quest             Quest    @relation("DependentQuest", fields: [questId], references: [id], onDelete: Cascade)
  prerequisiteQuest Quest    @relation("PrerequisiteQuest", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([questId, prerequisiteId])
  @@index([questId])
  @@index([prerequisiteId])
  @@map("quest_prerequisites")
}

// Achievement: Badges/achievements earned by completing quests or milestones
model Achievement {
  id                String   @id @default(cuid())
  key               String   @unique
  title             String
  description       String
  iconUrl           String?
  criteriaType      String   // 'quest_completion' | 'quest_line_completion' | 'streak' | 'custom'
  criteriaJson      Json     // { questId?, questLineId?, count?, etc. }
  rewardJson        Json?    // Optional currency reward
  rarity            String   @default("common") // 'common' | 'rare' | 'epic' | 'legendary'
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  relatedQuestId    String?
  relatedQuest      Quest?   @relation(fields: [relatedQuestId], references: [id], onDelete: SetNull)

  earnedBy          MemberAchievement[]

  @@index([criteriaType])
  @@map("achievements")
}

// Member Achievement: Tracks which members earned which achievements
model MemberAchievement {
  id             String      @id @default(cuid())
  memberId       String
  achievementId  String
  earnedAt       DateTime    @default(now())
  metadata       Json?       // Additional context about how it was earned

  achievement    Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([memberId, achievementId])
  @@index([memberId])
  @@index([achievementId])
  @@index([earnedAt])
  @@map("member_achievements")
}

// Quest Analytics: Aggregated stats for each quest
model QuestAnalytics {
  id                     String   @id @default(cuid())
  questId                String   @unique
  totalEnrollments       Int      @default(0)
  totalCompletions       Int      @default(0)
  totalAbandoned         Int      @default(0)
  averageCompletionTime  Int?     // In minutes
  completionRate         Float?   // Percentage (0-100)
  averageRating          Float?   // If we add ratings later
  updatedAt              DateTime @updatedAt

  quest                  Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([completionRate])
  @@index([totalCompletions])
  @@map("quest_analytics")
}
